# NeuronLM Configuration
# Copy to .env and fill in values

NEURONLM_ENVIRONMENT=development
NEURONLM_DEBUG=true
NEURONLM_SECRET_KEY=change-me-in-production
NEURONLM_HOST=0.0.0.0
NEURONLM_PORT=8000

# Database
NEURONLM_DATABASE_URL=postgresql+asyncpg://neuronlm:neuronlm@localhost:5432/neuronlm

# Redis
NEURONLM_REDIS_URL=redis://localhost:6379/0

# Auth
NEURONLM_JWT_SECRET_KEY=change-me-in-production
NEURONLM_JWT_EXPIRY_MINUTES=60

# Rate Limiting
NEURONLM_RATE_LIMIT_REQUESTS_PER_MINUTE=60
NEURONLM_RATE_LIMIT_TOKENS_PER_MINUTE=500000

# Model
NEURONLM_DEFAULT_MODEL=neuronlm-7b
NEURONLM_MAX_CONTEXT_LENGTH=32768

# Logging
NEURONLM_LOG_LEVEL=INFO
